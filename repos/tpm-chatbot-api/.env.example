# Required
OPENAI_API_KEY=sk-your-key-here

# Exact origins of the pages embedding the widget. Never use *.
# https:// vs http:// and www. vs bare all count as different origins, so
# every one the site is reachable on needs its own entry. Production needs
# all four below: tpmconsulting.org is primary, tpmconsults.org serves the
# site until DNS moves. (tpmconsults.com does not exist - do not add it.)
#
# Spaces after the commas are tolerated; they are stripped on load.
#
#   ALLOWED_ORIGINS=https://tpmconsulting.org, https://www.tpmconsulting.org, https://tpmconsults.org, https://www.tpmconsults.org
ALLOWED_ORIGINS=http://localhost:5173

# Protects /escalations. Unset means the endpoint refuses to serve at all.
ADMIN_TOKEN=change-me-to-something-random

# Where the bot points people for anything outside the documents.
# Without these it declines and offers no next step.
PRICING_URL=
CONTACT_URL=
CONTACT_EMAIL=

# Who finds out when someone asks for a human. Any endpoint that accepts a
# JSON POST - Slack or Teams incoming webhook, Zapier catch hook, your own.
# Blank means escalations are saved and readable at /escalations but nobody
# is notified, and the assistant is told not to promise a callback.
#
# The bundle ships a receiver for this: setup/5-START-N8N.ps1 runs n8n and
# automation/n8n/tpm-escalation-email-workflow.json emails the operator. With
# that imported and ACTIVE, the value is:
#   http://localhost:5678/webhook/tpm-escalation
# Setup and end-to-end verification: automation/n8n/README-escalation.md
ESCALATION_WEBHOOK_URL=

# Optional - defaults shown
CHAT_MODEL=gpt-4o-mini
QDRANT_URL=http://localhost:6333
RATE_LIMIT_PER_MIN=12
CHAT_RATE_LIMIT_PER_MIN=6
DAILY_TURN_CAP=2000
