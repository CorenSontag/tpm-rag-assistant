# ---- required -------------------------------------------------------------
OPENAI_API_KEY=sk-put-your-key-here

# ---- required before going public ----------------------------------------
# Exact origin of the page embedding the widget. Never *.
# https:// vs http:// and www. vs bare all count as different origins.
ALLOWED_ORIGINS=http://localhost:5173

# Protects /escalations. Unset means that endpoint refuses to serve at all.
ADMIN_TOKEN=change-me-to-something-long-and-random

# ---- where the bot sends people for anything outside the corpus -----------
PRICING_URL=
CONTACT_URL=
CONTACT_EMAIL=

# ---- who finds out when someone asks for a human --------------------------
# Any endpoint that accepts a JSON POST: a Slack or Teams incoming webhook, a
# Zapier catch hook, your own handler.
#
# Leave it blank and escalations are still saved and still readable at
# /escalations - but NOBODY IS TOLD, so the assistant is instructed not to
# promise a callback and to give out the contact details above instead.
# Blank is a supported state; it is not a working one if you want a reply.
#
# The bundle ships a receiver: setup/5-START-N8N.ps1 runs n8n and
# automation/n8n/tpm-escalation-email-workflow.json emails the operator. With
# that imported and ACTIVE, the value is:
#   http://localhost:5678/webhook/tpm-escalation
# Setup and end-to-end verification: automation/n8n/README-escalation.md
ESCALATION_WEBHOOK_URL=

# ---- optional, defaults shown --------------------------------------------
CHAT_MODEL=gpt-4o-mini
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs
RATE_LIMIT_PER_MIN=12
CHAT_RATE_LIMIT_PER_MIN=6
DAILY_TURN_CAP=2000

# ---- reranking: off by default -------------------------------------------
# Retrieve top_k * RERANK_MULTIPLIER, then let a local cross-encoder pick the
# best top_k. Costs no API spend (the model runs on your machine) but adds
# 100-400 ms per query and a 1-2 GB one-time download.
#   pip install "tpm-rag[rerank]"
# Leave it off for the port itself, then A/B it - a regression is ambiguous if
# you change retrieval and the machine at the same time.
# RERANK=1
# RERANK_MULTIPLIER=4

# Only if tesseract is not on PATH, and only needed for re-ingesting.
#   Windows  C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=
